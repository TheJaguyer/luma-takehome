# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2

# ─── Shots ────────────────────────────────────────────────────────────────────
# Required. The Luma key can stay in .env.local instead; compose.yaml reads both files.
LUMA_AGENTS_API_KEY=xxxxx

# Slack app, created from slack/manifest.yaml.
SLACK_BOT_TOKEN=xoxb-xxxxx          # OAuth & Permissions → Bot User OAuth Token
SLACK_SIGNING_SECRET=xxxxx          # Basic Information → Signing Secret
SLACK_APP_TOKEN=xapp-xxxxx          # Basic Information → App-Level Tokens (connections:write).
                                    # Set = Socket Mode (local). Remove when deployed behind HTTPS.

# Deployed only. Locally both default to http://localhost.
# SITE_ADDRESS=shots.example.com
# PUBLIC_BASE_URL=https://shots.example.com

# Deployed only: override the local-dev defaults in compose.yaml.
# POSTGRES_PASSWORD=
# GARAGE_RPC_SECRET=                # 64 hex chars:  openssl rand -hex 32
# GARAGE_ADMIN_TOKEN=               # openssl rand -base64 32
# S3_ACCESS_KEY_ID=                 # "GK" + 24 hex: echo GK$(openssl rand -hex 12)
# S3_SECRET_ACCESS_KEY=             # 64 hex chars:  openssl rand -hex 32

# Optional. Minutes before something counts as stuck (status, nudges) — for demos and testing.
# Unset, the team's setting applies: 3 days, and 30 minutes for generations.
# STUCK_AFTER_MINUTES=5
