# Copy to .env and fill in. Every variable is listed in docs/INSTALL.md, "Appendix: every variable".
#
#   Local (Path A):  fill in "Required everywhere" and "Local only". Leave the rest commented out.
#   Deployed (Path B): don't copy this by hand. `deploy/make-prod-env.sh <host>` writes
#                      .env.production with every value in "Deployed only" generated for you, and
#                      deploy/push.sh copies it to the server as .env.

# ─── Required everywhere ─────────────────────────────────────────────────────
# Drafting shot ideas (Claude).
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Image generation (Luma uni-1). Can live in .env.local instead: compose.yaml reads both, and
# .env.local wins.
LUMA_AGENTS_API_KEY=xxxxx

# From the Slack app created from slack/manifest.yaml.
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxx
# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=xxxxx

# ─── Local only ──────────────────────────────────────────────────────────────
# Basic Information → App-Level Tokens, with the connections:write scope.
# Present = Socket Mode (local). Leave it out when deployed: its absence selects HTTP mode.
SLACK_APP_TOKEN=xapp-xxxxx

# ─── Deployed only ───────────────────────────────────────────────────────────
# Both default to http://localhost. SITE_ADDRESS is the bare hostname Caddy gets a certificate
# for; PUBLIC_BASE_URL is written into every approved image's URL, so set it before approving.
# SITE_ADDRESS=shots.example.com
# PUBLIC_BASE_URL=https://shots.example.com

# The local defaults in compose.yaml are deliberately weak. Generated by make-prod-env.sh.
# POSTGRES_PASSWORD=
# 64 hex chars: openssl rand -hex 32
# GARAGE_RPC_SECRET=
# openssl rand -hex 32
# GARAGE_ADMIN_TOKEN=
# "GK" + 24 hex chars: echo GK$(openssl rand -hex 12)
# S3_ACCESS_KEY_ID=
# 64 hex chars: openssl rand -hex 32
# S3_SECRET_ACCESS_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# Minutes before something counts as stuck (status, nudges). Unset: 3 days, and 30 minutes for
# generations. For demos and testing only.
# STUCK_AFTER_MINUTES=5
# Luma's pay-as-you-go cap on generations in flight. Raise it with a bigger Luma plan.
# LUMA_MAX_CONCURRENT=10
# S3_BUCKET=shots
# LOG_LEVEL=info
